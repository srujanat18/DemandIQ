# DemandIQ Database Configuration
# Options: 'sqlite' or 'mysql'
DB_TYPE=sqlite

# If DB_TYPE=mysql, configure the following:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=demandiq

# SQLite database file path (if DB_TYPE=sqlite)
SQLITE_PATH=database/demandiq.db

# Flask Application Config
FLASK_APP=run_app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=demandiq-secret-key-super-secure

# External API Configuration
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# AWS S3 Configuration (Optional for cloud ETL)
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=demandiq-data-lake-raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
